
# Drupal JSON:API base URL.
# Example:
# DRUPAL_BASE_URL=https://develop-example.pantheonsite.io
DRUPAL_BASE_URL=

# Optional: use this when testing against a local DDEV Drupal site.
# DRUPAL_BASE_URL=https://example.ddev.site

# Drupal HTTP Basic Authentication credentials.
DRUPAL_USERNAME=
DRUPAL_PASSWORD=

# Upstream API gateway credentials.
# Optional when the Drupal API does not require these headers.
CONSUMERUUID=
API_KEY=

# Secret used by the POST /api/revalidate endpoint.
# Generate a strong random value for local/production use.
CMSJUMPSTART_REVALIDATION_SECRET=

# Secret used by the signed-token /preview workflow.
# Generate a strong random value for local/production use.
CMSJUMPSTART_PREVIEW_SECRET=

# Exact origin of the Drupal editor interface for signed-token preview.
# Example: https://cms.example.com
CMSJUMPSTART_PREVIEW_ALLOWED_ORIGIN=

# Secret shared between Next.js and the Drupal native-preview integration.
# Used only for server-to-server ticket redemption.
CMSJUMPSTART_NATIVE_PREVIEW_SECRET=

# Exact origin of the Drupal site serving the native-preview handoff form.
# Example: https://cms.example.com
CMSJUMPSTART_NATIVE_PREVIEW_DRUPAL_ORIGIN=

# Absolute Drupal ticket-redemption endpoint URL.
# Must use the configured Drupal origin and contain no query string or fragment.
# Example: https://cms.example.com/cmsjumpstart/preview/redeem
CMSJUMPSTART_NATIVE_PREVIEW_REDEEM_URL=

# Exact origin allowed to submit requests to the exit-preview endpoint.
# Example: https://cms.example.com
CMSJUMPSTART_EXIT_PREVIEW_ALLOWED_ORIGIN=
