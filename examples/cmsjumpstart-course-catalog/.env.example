# Drupal JSON:API base URL.
# Example:
# DRUPAL_BASE_URL=https://develop-example.pantheonsite.io
DRUPAL_BASE_URL=

# Optional: use this when testing against a local DDEV Drupal site.
# DRUPAL_BASE_URL=https://example.ddev.site

# Drupal HTTP Basic Authentication credentials.
HTAUTH_U=
HTAUTH_P=

# Upstream API gateway credentials.
CONSUMERUUID=
UP_API_KEY=

# Secret used by the POST /api/revalidate endpoint.
# Generate a strong random value for local/production use.
CMSJUMPSTART_REVALIDATION_SECRET=

# Secret used by the /preview endpoint.
# Generate a strong random value for local/production use.
CMSJUMPSTART_PREVIEW_SECRET=