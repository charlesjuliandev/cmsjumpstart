{
  "name": "cmsjumpstart",
  "version": "0.1.0",
  "private": true,
  "description": "Production-ready starters for headless CMS platforms",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.20.0",

  "scripts": {
    "build": "pnpm -r build",
    "clean": "pnpm -r clean",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "typecheck": "pnpm -r exec tsc --noEmit"
  },

  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.20.0",
      "onFail": "download"
    }
  },

  "engines": {
    "node": ">=22",
    "pnpm": ">=11"
  },

  "devDependencies": {
    "typescript": "5.9.3",
    "vitest": "^4.1.10"
  }
}