  },
  "dependencies": {
    "@cmsjumpstart/drupal": "workspace:*"
  },
  "peerDependencies": {
    "next": "^16.3.3"
  },
  "devDependencies": {
    "next": "^16.3.3",
    "typescript": "^5.9.3"
  }
}

