{
  "name": "@cmsjumpstart/next",
  "version": "0.1.0",
  "description": "Next.js integration for CMSJumpstart",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
